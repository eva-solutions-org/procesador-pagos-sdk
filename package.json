{
  "name": "@eva/procesador-pagos-sdk",
  "version": "0.2.0",
  "description": "SDK TypeScript para consumir el servicio Procesador-de-pagos",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./hono/upstash": {
      "types": "./dist/hono/upstash.d.ts",
      "import": "./dist/hono/upstash.js",
      "require": "./dist/hono/upstash.cjs"
    },
    "./hono/durable-objects": {
      "types": "./dist/hono/durable-objects.d.ts",
      "import": "./dist/hono/durable-objects.js",
      "require": "./dist/hono/durable-objects.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "build:local": "cross-env EVA_PAGOS_BUILD_ENV=local tsdown",
    "build:dev": "cross-env EVA_PAGOS_BUILD_ENV=development tsdown",
    "build:prod": "cross-env EVA_PAGOS_BUILD_ENV=production tsdown",
    "pack:local": "pnpm run build:local && pnpm pack",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "prepublishOnly": "pnpm run typecheck && pnpm run test:run && pnpm run build:prod"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@upstash/redis": ">=1.0.0",
    "hono": ">=4.12.4",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@upstash/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@upstash/redis": "^1.37.0",
    "cross-env": "^10.1.0",
    "hono": "^4.12.15",
    "jsdom": "^29.1.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.59.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.10",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
